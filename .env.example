PORT=5000
MONGO_URI=mongodb+srv://admin:<db_password>@cluster0.hp61nd3.mongodb.net/mydatabase?retryWrites=true&w=majority

# API Bearer token — must match VITE_ADMIN_SECRET in the frontend (Vercel)
ADMIN_SECRET=your_admin_secret_here

# Login password — validated server-side at POST /api/admin/login
ADMIN_PASSWORD=your_admin_password_here

# Comma-separated allowed frontend origins (include your Vercel URL)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
NODE_ENV=development
